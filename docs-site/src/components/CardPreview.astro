---
/**
 * Interactive card preview component showing the 4 Anki card types
 * with flip animation, real audio playback, and OpenMoji icons.
 */

const basePath = "/ChineseHSK";

const cards = [
  // Recognition cards (5)
  { type: "recognition", icon: "waving-hand", audioWord: "daily_001_word", audioSentence: "daily_001_sentence",
    front: { hanzi: "你好" },
    back: { hanzi: "你好", pinyin: "nǐ hǎo", spanish: "Hola", english: "Hello", example: "你好，我叫小明", exPinyin: "nǐ hǎo, wǒ jiào xiǎomíng", exEs: "Hola, me llamo Xiaoming" }},
  { type: "recognition", icon: "thumbs-up", audioWord: "daily_008_word", audioSentence: "daily_008_sentence",
    front: { hanzi: "谢谢" },
    back: { hanzi: "谢谢", pinyin: "xiè xie", spanish: "Gracias", english: "Thank you", example: "谢谢你的帮助", exPinyin: "xièxie nǐ de bāngzhù", exEs: "Gracias por tu ayuda" }},
  { type: "recognition", icon: "eating", audioWord: "hsk1_051_word", audioSentence: "hsk1_051_sentence",
    front: { hanzi: "吃" },
    back: { hanzi: "吃", pinyin: "chī", spanish: "Comer", english: "To eat", example: "你们想吃什么？", exPinyin: "nǐmen xiǎng chī shénme?", exEs: "¿Qué quieren comer?" }},
  { type: "recognition", icon: "student", audioWord: "hsk1_006_word", audioSentence: "hsk1_006_sentence",
    front: { hanzi: "学生" },
    back: { hanzi: "学生", pinyin: "xuéshēng", spanish: "Estudiante", english: "Student", example: "他不是学生", exPinyin: "tā bù shì xuéshēng", exEs: "Él no es estudiante" }},
  { type: "recognition", icon: "person", audioWord: "hsk1_016_word", audioSentence: "hsk1_016_sentence",
    front: { hanzi: "朋友" },
    back: { hanzi: "朋友", pinyin: "péngyǒu", spanish: "Amigo", english: "Friend", example: "她是我的好朋友", exPinyin: "tā shì wǒ de hǎo péngyǒu", exEs: "Ella es mi buena amiga" }},

  // Production cards (5)
  { type: "production", icon: "name-tag", audioWord: "hsk1_001_word",
    front: { spanish: "Llamarse", english: "To be called" },
    back: { hanzi: "叫", pinyin: "jiào", spanish: "Llamarse", english: "To be called" }},
  { type: "production", icon: "teacher", audioWord: "hsk1_005_word",
    front: { spanish: "Profesor/a", english: "Teacher" },
    back: { hanzi: "老师", pinyin: "lǎoshī", spanish: "Profesor/a", english: "Teacher" }},
  { type: "production", icon: "water", audioWord: "hsk1_106_word",
    front: { spanish: "Agua", english: "Water" },
    back: { hanzi: "水", pinyin: "shuǐ", spanish: "Agua", english: "Water" }},
  { type: "production", icon: "cooking", audioWord: "hsk1_031_word",
    front: { spanish: "Hacer, cocinar", english: "To do, to cook" },
    back: { hanzi: "做", pinyin: "zuò", spanish: "Hacer, cocinar", english: "To do, to cook" }},
  { type: "production", icon: "hospital", audioWord: "hsk1_073_word",
    front: { spanish: "Hospital", english: "Hospital" },
    back: { hanzi: "医院", pinyin: "yīyuàn", spanish: "Hospital", english: "Hospital" }},

  // Listening cards (5)
  { type: "listening", icon: "china", audioWord: "hsk1_008_word",
    front: {}, back: { hanzi: "中国", pinyin: "zhōngguó", spanish: "China", english: "China" }},
  { type: "listening", icon: "working", audioWord: "hsk1_071_word",
    front: {}, back: { hanzi: "工作", pinyin: "gōngzuò", spanish: "Trabajar", english: "To work" }},
  { type: "listening", icon: "computer", audioWord: "hsk1_078_word",
    front: {}, back: { hanzi: "电脑", pinyin: "diànnǎo", spanish: "Computadora", english: "Computer" }},
  { type: "listening", icon: "money", audioWord: "hsk1_060_word",
    front: {}, back: { hanzi: "钱", pinyin: "qián", spanish: "Dinero", english: "Money" }},
  { type: "listening", icon: "rain", audioWord: "hsk1_099_word",
    front: {}, back: { hanzi: "下雨", pinyin: "xià yǔ", spanish: "Llover", english: "To rain" }},

  // Cloze cards (5)
  { type: "cloze", audioSentence: "hsk1_001_sentence", audioWord: "hsk1_001_word",
    front: { sentence: "他___David", sentenceEs: "Él se llama David" },
    back: { answer: "叫", hanzi: "叫", pinyin: "jiào", full: "他叫David", fullPinyin: "tā jiào David" }},
  { type: "cloze", audioSentence: "hsk1_051_sentence", audioWord: "hsk1_051_word",
    front: { sentence: "你们想___什么？", sentenceEs: "¿Qué quieren comer?" },
    back: { answer: "吃", hanzi: "吃", pinyin: "chī", full: "你们想吃什么？", fullPinyin: "nǐmen xiǎng chī shénme?" }},
  { type: "cloze", audioSentence: "hsk1_012_sentence", audioWord: "hsk1_012_word",
    front: { sentence: "她是我的___老师", sentenceEs: "Ella es mi profesora de chino" },
    back: { answer: "汉语", hanzi: "汉语", pinyin: "hànyǔ", full: "她是我的汉语老师", fullPinyin: "tā shì wǒ de hànyǔ lǎoshī" }},
  { type: "cloze", audioSentence: "hsk1_099_sentence", audioWord: "hsk1_099_word",
    front: { sentence: "明天会___吗？", sentenceEs: "¿Lloverá mañana?" },
    back: { answer: "下雨", hanzi: "下雨", pinyin: "xià yǔ", full: "明天会下雨吗？", fullPinyin: "míngtiān huì xià yǔ ma?" }},
  { type: "cloze", audioSentence: "hsk1_073_sentence", audioWord: "hsk1_073_word",
    front: { sentence: "我在___工作", sentenceEs: "Trabajo en el hospital" },
    back: { answer: "医院", hanzi: "医院", pinyin: "yīyuàn", full: "我在医院工作", fullPinyin: "wǒ zài yīyuàn gōngzuò" }},
];

const typeLabels: Record<string, { es: string; en: string; color: string }> = {
  recognition: { es: "Reconocer", en: "Recognition", color: "#3498db" },
  production: { es: "Traducir", en: "Translate", color: "#2ecc71" },
  listening: { es: "Escuchar", en: "Listening", color: "#9b59b6" },
  cloze: { es: "Completar", en: "Fill in", color: "#e74c3c" },
};
---

<div class="card-preview-container">
  <div class="card-type-tabs" id="card-type-tabs">
    {Object.entries(typeLabels).map(([type, label]) => (
      <button class={`type-tab ${type === 'recognition' ? 'active' : ''}`} data-type={type} style={`--tab-color: ${label.color}`}>
        <span class="tab-es">{label.es}</span>
        <span class="tab-en">{label.en}</span>
      </button>
    ))}
  </div>

  <p class="click-hint" id="click-hint">
    <span class="hint-es">Haz clic en la tarjeta para voltearla</span>
    <span class="hint-en">Click the card to flip it</span>
  </p>

  <div class="cards-carousel" id="cards-carousel">
    {cards.map((card, i) => (
      <div class={`flip-card ${card.type === 'recognition' && i === 0 ? 'visible' : ''}`}
           data-card-type={card.type}
           data-index={i}
           data-audio-word={card.audioWord || ''}
           data-audio-sentence={card.audioSentence || ''}>
        <div class="flip-card-inner">
          {/* FRONT */}
          <div class="flip-card-front">
            <div class="anki-card">
              {card.type === "recognition" && (
                <div>
                  <img class="card-icon" src={`${basePath}/icons/${card.icon}.svg`} alt="" />
                  <div class="card-hanzi">{card.front.hanzi}</div>
                </div>
              )}
              {card.type === "production" && (
                <div>
                  <img class="card-icon" src={`${basePath}/icons/${card.icon}.svg`} alt="" />
                  <div class="card-label">ESPAÑOL</div>
                  <div class="card-meaning-es">{card.front.spanish}</div>
                  <div class="card-label">ENGLISH</div>
                  <div class="card-meaning-en">{card.front.english}</div>
                </div>
              )}
              {card.type === "listening" && (
                <div>
                  <div class="card-listening-icon">🔊</div>
                  <div class="card-label">LISTEN AND IDENTIFY</div>
                  <button class="play-btn" data-audio={`${basePath}/audio/${card.audioWord}.mp3`} onclick="event.stopPropagation(); this.parentElement.querySelector('.play-btn') && new Audio(this.dataset.audio).play()">
                    ▶ Play Audio
                  </button>
                </div>
              )}
              {card.type === "cloze" && (
                <div>
                  <div class="card-cloze-sentence">{card.front.sentence}</div>
                  <div class="card-divider"></div>
                  <div class="card-label">ESPAÑOL</div>
                  <div class="card-cloze-translation">{card.front.sentenceEs}</div>
                </div>
              )}
            </div>
          </div>
          {/* BACK */}
          <div class="flip-card-back">
            <div class="anki-card">
              {card.type === "recognition" && (
                <div>
                  <div class="card-hanzi-back">{card.back.hanzi}</div>
                  <div class="card-pinyin">{card.back.pinyin}</div>
                  <div class="card-divider"></div>
                  <div class="card-meaning-es">{card.back.spanish}</div>
                  <div class="card-meaning-en">{card.back.english}</div>
                  <div class="card-divider"></div>
                  <div class="card-example">
                    <div class="card-example-zh">{card.back.example}</div>
                    <div class="card-example-sub">{card.back.exPinyin}</div>
                    <div class="card-example-sub">{card.back.exEs}</div>
                  </div>
                </div>
              )}
              {card.type === "production" && (
                <div>
                  <div class="card-hanzi-back">{card.back.hanzi}</div>
                  <div class="card-pinyin">{card.back.pinyin}</div>
                  <div class="card-divider"></div>
                  <div class="card-meaning-es">{card.back.spanish}</div>
                  <div class="card-meaning-en">{card.back.english}</div>
                </div>
              )}
              {card.type === "listening" && (
                <div>
                  <img class="card-icon" src={`${basePath}/icons/${card.icon}.svg`} alt="" />
                  <div class="card-hanzi-back">{card.back.hanzi}</div>
                  <div class="card-pinyin">{card.back.pinyin}</div>
                  <div class="card-divider"></div>
                  <div class="card-meaning-es">{card.back.spanish}</div>
                  <div class="card-meaning-en">{card.back.english}</div>
                </div>
              )}
              {card.type === "cloze" && (
                <div>
                  <div class="card-example">
                    <div class="card-example-zh">{card.back.full}</div>
                    <div class="card-example-sub">{card.back.fullPinyin}</div>
                  </div>
                  <div class="card-divider"></div>
                  <div class="card-hanzi-back" style="font-size:48px;">{card.back.hanzi}</div>
                  <div class="card-pinyin">{card.back.pinyin}</div>
                </div>
              )}
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>

  <div class="carousel-controls">
    <button class="carousel-btn" id="prev-btn">&#8592;</button>
    <span class="carousel-counter" id="carousel-counter">1 / 5</span>
    <button class="carousel-btn" id="next-btn">&#8594;</button>
  </div>

  <div class="anki-buttons-demo">
    <button class="anki-btn anki-again">Again</button>
    <button class="anki-btn anki-hard">Hard</button>
    <button class="anki-btn anki-good">Good</button>
    <button class="anki-btn anki-easy">Easy</button>
  </div>
</div>

<style>
  .card-preview-container {
    margin: 2rem 0;
  }

  .card-type-tabs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.5rem;
    margin-bottom: 1rem;
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }

  .type-tab {
    padding: 0.5rem 0.5rem;
    border: 2px solid var(--tab-color);
    border-radius: 24px;
    background: transparent;
    color: var(--sl-color-text);
    cursor: pointer;
    font-size: 0.85rem;
    transition: all 0.2s;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    min-height: 52px;
  }

  .type-tab:hover, .type-tab.active {
    background: var(--tab-color);
    color: white;
  }

  .tab-en { font-size: 0.7rem; opacity: 0.7; }

  .click-hint {
    text-align: center;
    font-size: 0.85rem;
    color: var(--sl-color-gray-2);
    margin-bottom: 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }

  .hint-en { font-size: 0.75rem; opacity: 0.7; }

  .cards-carousel {
    position: relative;
    min-height: 340px;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
  }

  .flip-card {
    display: none;
    width: 100%;
    max-width: 420px;
    height: 320px;
    perspective: 1000px;
    cursor: pointer;
  }

  .flip-card.visible {
    display: block;
    animation: slideIn 0.35s ease-out;
  }

  .flip-card.slide-out-left {
    display: block;
    animation: slideOutLeft 0.25s ease-in forwards;
  }

  .flip-card.slide-out-right {
    display: block;
    animation: slideOutRight 0.25s ease-in forwards;
  }

  @keyframes slideIn {
    from { opacity: 0; transform: translateX(40px); }
    to { opacity: 1; transform: translateX(0); }
  }

  @keyframes slideInFromLeft {
    from { opacity: 0; transform: translateX(-40px); }
    to { opacity: 1; transform: translateX(0); }
  }

  @keyframes slideOutLeft {
    from { opacity: 1; transform: translateX(0); }
    to { opacity: 0; transform: translateX(-40px); }
  }

  @keyframes slideOutRight {
    from { opacity: 1; transform: translateX(0); }
    to { opacity: 0; transform: translateX(40px); }
  }

  .flip-card-inner {
    position: relative;
    width: 100%;
    height: 100%;
    transition: transform 0.6s;
    transform-style: preserve-3d;
  }

  .flip-card.flipped .flip-card-inner {
    transform: rotateY(180deg);
  }

  .flip-card-front, .flip-card-back {
    position: absolute;
    width: 100%;
    height: 100%;
    backface-visibility: hidden;
    border-radius: 12px;
    overflow: hidden;
  }

  .flip-card-back { transform: rotateY(180deg); }

  .anki-card {
    font-family: "Noto Sans SC", -apple-system, sans-serif;
    text-align: center;
    padding: 24px 20px;
    background: #fafafa;
    color: #333;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    box-shadow: 0 4px 16px rgba(0,0,0,0.12);
    border: 1px solid #e0e0e0;
    box-sizing: border-box;
  }

  .anki-card > div { width: 100%; }

  .card-icon {
    width: 48px;
    height: 48px;
    display: block;
    margin: 0 auto 8px;
  }

  .card-hanzi {
    font-size: 64px;
    font-weight: bold;
    color: #1a1a1a;
    margin: 8px 0;
  }

  .card-hanzi-back {
    font-size: 56px;
    font-weight: bold;
    color: #1a1a1a;
    margin: 4px 0;
  }

  .card-pinyin {
    font-size: 20px;
    color: #666;
    margin: 4px 0;
  }

  .card-meaning-es {
    font-size: 20px;
    color: #2c3e50;
    font-weight: bold;
    margin: 4px 0;
  }

  .card-meaning-en {
    font-size: 15px;
    color: #7f8c8d;
    font-style: italic;
    margin: 2px 0;
  }

  .card-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #aaa;
    margin-top: 8px;
  }

  .card-divider {
    border-top: 1px solid #ddd;
    margin: 8px 0;
  }

  .card-example {
    padding: 8px 10px;
    background: #f0f0f0;
    border-radius: 8px;
    border-left: 4px solid #3498db;
    text-align: left;
  }

  .card-example-zh {
    font-size: 17px;
    color: #1a1a1a;
  }

  .card-example-sub {
    font-size: 13px;
    color: #666;
    margin-top: 3px;
  }

  .card-listening-icon {
    font-size: 64px;
    margin: 10px 0;
  }

  .play-btn {
    margin-top: 12px;
    padding: 8px 24px;
    border: 2px solid #3498db;
    border-radius: 24px;
    background: transparent;
    color: #3498db;
    font-size: 14px;
    font-weight: bold;
    cursor: pointer;
    transition: all 0.2s;
  }

  .play-btn:hover {
    background: #3498db;
    color: white;
  }

  .card-cloze-sentence {
    font-size: 26px;
    font-weight: bold;
    color: #1a1a1a;
    padding: 10px;
    background: #f0f0f0;
    border-radius: 8px;
    border-left: 4px solid #e74c3c;
  }

  .card-cloze-translation {
    font-size: 14px;
    color: #666;
    margin: 4px 0;
  }

  .carousel-controls {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    margin-top: 1rem;
  }

  .carousel-btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 2px solid var(--sl-color-gray-4);
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
    font-size: 18px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
  }

  .carousel-btn:hover {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-accent);
  }

  .carousel-counter {
    font-size: 0.9rem;
    color: var(--sl-color-gray-2);
    min-width: 50px;
    text-align: center;
  }

  .anki-buttons-demo {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1rem;
    opacity: 0.7;
  }

  .anki-btn {
    padding: 6px 16px;
    border: none;
    border-radius: 6px;
    font-size: 0.8rem;
    cursor: default;
    color: white;
  }

  .anki-again { background: #e74c3c; }
  .anki-hard { background: #e67e22; }
  .anki-good { background: #2ecc71; }
  .anki-easy { background: #3498db; }

  @media (max-width: 600px) {
    .card-type-tabs {
      grid-template-columns: repeat(2, 1fr);
      max-width: 280px;
    }
    .flip-card { height: 300px; max-width: 100%; }
    .card-hanzi { font-size: 48px; }
    .card-hanzi-back { font-size: 42px; }
    .card-cloze-sentence { font-size: 20px; }
    .type-tab { font-size: 0.8rem; }
    .anki-card { padding: 16px 12px; }
    .card-example-zh { font-size: 15px; }
  }

  @media (max-width: 360px) {
    .card-hanzi { font-size: 40px; }
    .card-hanzi-back { font-size: 36px; }
    .card-meaning-es { font-size: 17px; }
    .card-cloze-sentence { font-size: 18px; }
  }
</style>

<script define:vars={{ basePath }}>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('.type-tab');
    const allCards = document.querySelectorAll('.flip-card');
    const counter = document.getElementById('carousel-counter');
    const prevBtn = document.getElementById('prev-btn');
    const nextBtn = document.getElementById('next-btn');

    let activeType = 'recognition';
    let activeIndex = 0;
    let animating = false;

    function getCardsForType(type) {
      return Array.from(allCards).filter(c => c.dataset.cardType === type);
    }

    function playAudio(src) {
      if (src) {
        const audio = new Audio(src);
        audio.play().catch(() => {});
      }
    }

    function showCard(direction) {
      if (animating) return;
      const typeCards = getCardsForType(activeType);
      const currentVisible = document.querySelector('.flip-card.visible');

      if (currentVisible && direction) {
        animating = true;
        const slideOut = direction === 'next' ? 'slide-out-left' : 'slide-out-right';
        const slideIn = direction === 'next' ? 'slideIn' : 'slideInFromLeft';

        currentVisible.classList.add(slideOut);
        currentVisible.classList.remove('visible', 'flipped');

        setTimeout(() => {
          currentVisible.classList.remove(slideOut);
          allCards.forEach(c => c.classList.remove('visible', 'flipped', 'slide-out-left', 'slide-out-right'));

          if (typeCards[activeIndex]) {
            typeCards[activeIndex].classList.add('visible');
            typeCards[activeIndex].style.animation = 'none';
            typeCards[activeIndex].offsetHeight; // trigger reflow
            typeCards[activeIndex].style.animation = slideIn + ' 0.3s ease-out';

            if (activeType === 'listening') {
              const audioFile = typeCards[activeIndex].dataset.audioWord;
              if (audioFile) {
                setTimeout(() => playAudio(basePath + '/audio/' + audioFile + '.mp3'), 200);
              }
            }
          }
          counter.textContent = (activeIndex + 1) + ' / ' + typeCards.length;
          animating = false;
        }, 250);
      } else {
        allCards.forEach(c => c.classList.remove('visible', 'flipped', 'slide-out-left', 'slide-out-right'));
        if (typeCards[activeIndex]) {
          typeCards[activeIndex].classList.add('visible');
          if (activeType === 'listening') {
            const audioFile = typeCards[activeIndex].dataset.audioWord;
            if (audioFile) {
              setTimeout(() => playAudio(basePath + '/audio/' + audioFile + '.mp3'), 300);
            }
          }
        }
        counter.textContent = (activeIndex + 1) + ' / ' + typeCards.length;
      }
    }

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        activeType = tab.dataset.type || 'recognition';
        activeIndex = 0;
        showCard();
      });
    });

    allCards.forEach(card => {
      card.addEventListener('click', (e) => {
        if (e.target.closest('.play-btn') || animating) return;
        const wasFlipped = card.classList.contains('flipped');
        card.classList.toggle('flipped');

        if (!wasFlipped) {
          const audioFile = card.dataset.audioWord;
          if (audioFile) {
            setTimeout(() => playAudio(basePath + '/audio/' + audioFile + '.mp3'), 300);
          }
          if (card.dataset.cardType === 'cloze') {
            const sentenceFile = card.dataset.audioSentence;
            if (sentenceFile) {
              setTimeout(() => playAudio(basePath + '/audio/' + sentenceFile + '.mp3'), 300);
            }
          }
        }
      });
    });

    prevBtn.addEventListener('click', () => {
      const typeCards = getCardsForType(activeType);
      activeIndex = (activeIndex - 1 + typeCards.length) % typeCards.length;
      showCard('prev');
    });

    nextBtn.addEventListener('click', () => {
      const typeCards = getCardsForType(activeType);
      activeIndex = (activeIndex + 1) % typeCards.length;
      showCard('next');
    });
  });
</script>
